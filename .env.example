# ── Server (Express / Node host) ───────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Public origin used for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://your-domain.com

# Secret used to sign admin session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Admin account ──────────────────────────────────────────────────────────
# Express: used on first seed. If ADMIN_PASSWORD is omitted, a strong random
# password is generated and written to ADMIN_CREDENTIALS.txt (gitignored).
# Netlify: REQUIRED. The admin account is created from these variables the
# first time the API runs (and re-checked on every request until it exists).
ADMIN_EMAIL=you@your-domain.com
# ADMIN_PASSWORD=use-a-long-random-password

# ── Optional: real email delivery for contact / newsletter ─────────────────
# The app stores submissions in the database by default. To also send email,
# implement server/mailer.js with your provider (SMTP, Resend, Postmark…).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_TO=

# ── Optional: real payments (Stripe) ───────────────────────────────────────
# Checkout runs in clearly-labelled DEMO mode until these are configured.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
